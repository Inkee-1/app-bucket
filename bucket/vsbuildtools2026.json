{
    "version": "18.11.2",
    "description": "Microsoft Visual Studio Build Tools 2026",
    "homepage": "https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2026",
    "license": "https://visualstudio.microsoft.com/zh-hans/license-terms/vs2026-ga-diagnostic-buildtools/",
    "url": "https://aka.ms/vs/18/release/vs_buildtools.exe",
    "hash": "ad0bc542a6757a7d2bffe25297f8d5434352b1dc821e993c9c35f09ea6d771a5",
    "installer": {
        "script": "Start-Process -FilePath \"$dir\\vs_buildtools.exe\" -ArgumentList \"--installPath $dir\\vs\\ --add Microsoft.VisualStudio.Workload.MSBuildTools --add Microsoft.VisualStudio.Workload.VCTools --add Microsoft.VisualStudio.Component.VC.Tools.x86.x64 --quiet --norestart\" -Wait"
    },
    "uninstaller": {
        "script": "Start-Process -FilePath \"$dir\\vs_buildtools.exe\" -ArgumentList \"uninstall --installPath $dir\\vs\\ --quiet --norestart\" -Wait"
    },
    "env_set": {
        "VS2022_ROOT": "$dir\\vs"
    },
    "env_add_path": [
        "vs\\Common7\\Tools",
        "vs\\Common7\\IDE",
        "vs\\MSBuild\\Current\\Bin",
        "vs\\VC\\Auxiliary\\Build"
    ],
    "checkver": {
        "url": "https://docs.microsoft.com/en-us/visualstudio/releases/2026/release-notes",
        "regex": ">Version ([\\d.]+)</h2>"
    },
    "autoupdate": {
        "url": "https://aka.ms/vs/18/release/vs_buildtools.exe"
    }
}
