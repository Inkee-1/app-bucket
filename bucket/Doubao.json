    "url": "https://lf-flow-web-cdn.doubao.com/obj/flow-doubao/doubao_pc/2.36.8/Doubao_installer_2.36.8.exe",
    "hash": "9a2ea3f09d962a2ac2009af735b8ac572459aae345892f8b02fc6db4f47b8cbd",
    "installer": {
        "script": [
            "$installArgs = @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/SP-', \"/DIR=$dir\", '/PORTABLE=1')",
            "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList $installArgs -Wait",
            "Remove-Item \"$dir\\$fname\" -Force",
            "Remove-Item \"$dir\\unins000.*\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Doubao.exe",
            "Doubao"
        ]
    ],
    "checkver": {
        "url": "https://www.doubao.com/samantha/desktop/get_latest_version?platform=windows&app_version=1.0.0",
        "regex": "\"newest_version\":\"([\\d.]+)\""
    },
    "autoupdate": {
        "url": "https://lf-flow-web-cdn.doubao.com/obj/flow-doubao/doubao_pc/$version/Doubao_installer_$version.exe"
    }
}
