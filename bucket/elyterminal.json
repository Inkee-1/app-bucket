{
    "version": "0.2.7",
    "description": "A terminal on GPUI and Ely components",
    "homepage": "https://github.com/ELY-Open-Source/ELYTerminal",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ELY-Open-Source/ELYTerminal/releases/download/v0.2.7/ELYTerminal-0.2.7-windows-x86_64.zip",
            "hash": "ced1e24ba40de84676a2d93ba0baf2d85b7aa65489d51bac4f559d7b26cef2ad"
        },
        "arm64": {
            "url": "https://github.com/ELY-Open-Source/ELYTerminal/releases/download/v0.2.7/ELYTerminal-0.2.7-windows-aarch64.zip",
            "hash": "1cf5cb35cb5c4be642622ba9f9ef626939e19229a1253122ef0db5dd98a723a4"
        }
    },
    "post_install": [
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\$bucket\\scripts\\elyterminal\\$_.reg\") {",
        "        $etPath = \"$dir\\elyterminal.exe\".Replace('\\', '\\\\')",
        "        $content = (Get-Content \"$bucketsdir\\$bucket\\scripts\\elyterminal\\$_.reg\").Replace('$et', $etPath)",
        "        if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "        Set-Content \"$dir\\$_.reg\" $content -Encoding Unicode -Force",
        "    }",
        "}",
        "reg add \"HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\et.exe\" /v \"Path\" /t REG_SZ /d \"$dir\\elyterminal.exe\" /f",
        "reg add \"HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\et.exe\" /ve /t REG_SZ /d \"$dir\\elyterminal.exe\" /f",
        "reg add \"HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\et.exe\" /v \"Path\" /t REG_SZ /d \"$dir\\elyterminal.exe\" /f",
        "reg add \"HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\et.exe\" /ve /t REG_SZ /d \"$dir\\elyterminal.exe\" /f"
    ],
    "bin": "elyterminal.exe",
    "shortcuts": [
        [
            "elyterminal.exe",
            "elyterminal"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ELY-Open-Source/ELYTerminal/releases/download/v$version/ELYTerminal-$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/ELY-Open-Source/ELYTerminal/releases/download/v$version/ELYTerminal-$version-windows-aarch64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/ELY-Open-Source/ELYTerminal/releases.atom",
            "regex": "Repository/\\d+/v([\\d.]+)<"
        }
    }
}
